// ВКМ Начало

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВКМ_СоздатьЭлементыАбонентскогоОбслуживания();
	ВКМ_УстановитьВидимостьАбонентскогоОбслуживания(Объект.ВидДоговора);

	// Подписка на изменение вида договора
	Элементы.ВидДоговора.УстановитьДействие("ПриИзменении", "ВКМ_ВидДоговораПриИзменении");

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ВКМ_УстановитьВидимостьАбонентскогоОбслуживания(ТекущийОбъект.ВидДоговора);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВКМ_СоздатьЭлементыАбонентскогоОбслуживания()

	Группа = Элементы.Добавить("ВКМ_ГруппаАбонентскоеОбслуживание", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = "Абонентское обслуживание";
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("ВКМ_ДатаНачала");
	ИменаРеквизитов.Добавить("ВКМ_ДатаОкончания");
	ИменаРеквизитов.Добавить("ВКМ_СуммаАбонентскойПлаты");
	ИменаРеквизитов.Добавить("ВКМ_СтоимостьЧасаРаботы");

	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Поле = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Группа);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = "Объект." + ИмяРеквизита;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВКМ_УстановитьВидимостьАбонентскогоОбслуживания(ВидДоговора)

	Элементы.ВКМ_ГруппаАбонентскоеОбслуживание.Видимость =
		(ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание);

КонецПроцедуры

&НаКлиенте
Процедура ВКМ_ВидДоговораПриИзменении(Элемент)

	Элементы.ВКМ_ГруппаАбонентскоеОбслуживание.Видимость =
		(Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание"));

КонецПроцедуры

#КонецОбласти

// ВКМ Конец