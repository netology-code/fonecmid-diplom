
#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТокен()
    Возврат Константы.ВКМ_ТокенУправленияТелеграм.Получить();
КонецФункции

Функция ПолучитьChatID()
    Возврат Константы.ВКМ_ИдентификаторГруппыДляОповещения.Получить();
КонецФункции

Функция ОтправитьСообщение(Знач ТекстСообщения, Знач ИспользоватьПрокси = Ложь) Экспорт
    
    Токен  = ПолучитьТокен();
    ChatID = ПолучитьChatID();

	// Адрес сервера и путь к методу API
	//ИмяСервера = "api.telegram.org";
	ПутьКРесурсу = "/bot" + Токен + "/sendMessage";
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	Соединение = Новый HTTPСоединение("api.telegram.org",443,,,,,ЗащищенноеСоединение);
	
	 // Формирование структуры тела запроса
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("chat_id", ChatID);
	ДанныеЗапроса.Вставить("text", ТекстСообщения);

	// Сериализация в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеЗапроса);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// Создание HTTP-запроса
	HTTPЗапрос = Новый HTTPЗапрос(ПутьКРесурсу);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8");
	    
	Ответ = Соединение.Получить(HTTPЗапрос);
	
	Если Ответ.КодСостояния = 200 тогда
	     ОбщегоНазначения.СообщитьПользователю("Успешно");
		 Возврат Истина;
	 Иначе
		 ОбщегоНазначения.СообщитьПользователю("Ошибка");
	    ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	    ЗаписьЖурналаРегистрации("Телеграм.ОтправитьСообщение", УровеньЖурналаРегистрации.Ошибка, , ,
	        "Ошибка отправки сообщения. Код состояния: " + Ответ.КодСостояния + ". Тело ответа: " + ТелоОтвета);
		Возврат Ложь;
	КонецЕсли;
	    	    
КонецФункции
 
Процедура ВКМ_УведомленияТелеграмБоту() Экспорт 
	
	Выборка = Справочники.ВКМ_УведомленияТелеграмБоту.Выбрать(); 
	
	Пока Выборка.Следующий() Цикл 
		Текст = Выборка.Текст;
        Если ОтправитьСообщение(Текст) Тогда
            // Удаляем после успешной отправки
            Выборка.Удалить();
        Иначе
            // Записать ошибку в журнал и не удалять
            ЗаписьЖурналаРегистрации("ОшибкаTelegram", УровеньЖурналаРегистрации.Ошибка, , , "Не удалось отправить уведомление " + Выборка.Ссылка);
        КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры  

#КонецОбласти