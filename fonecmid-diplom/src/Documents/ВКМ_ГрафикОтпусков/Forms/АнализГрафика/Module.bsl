#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ТаблицаОтпусков = ПолучитьИзВременногоХранилища(Параметры.Адрес);
    Если ТаблицаОтпусков = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Очистка диаграммы
    ДиаграммаГанта.Очистить();
    
    // Серия "Отпуск"
    СерияОтпуск = ДиаграммаГанта.Серии.Добавить();
    СерияОтпуск.Текст = "Отпуск";
    СерияОтпуск.Цвет = WebЦвета.Бирюзовый;
    
    // Группировка отпусков по сотрудникам
    ОтпускаПоСотрудникам = Новый Соответствие;
    Для Каждого СтрокаОтпуска Из ТаблицаОтпусков Цикл
        Сотрудник = СтрокаОтпуска.Сотрудник;
        Если Сотрудник = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        
        МассивИнтервалов = ОтпускаПоСотрудникам.Получить(Сотрудник);
        Если МассивИнтервалов = Неопределено Тогда
            МассивИнтервалов = Новый Массив;
            ОтпускаПоСотрудникам.Вставить(Сотрудник, МассивИнтервалов);
        КонецЕсли;
        
        // Сохраняем структуру интервала
        ИнтервалСтруктура = Новый Структура("Начало, Конец");
        ИнтервалСтруктура.Начало = СтрокаОтпуска.ДатаНачала;
        ИнтервалСтруктура.Конец = СтрокаОтпуска.ДатаОкончания;
        МассивИнтервалов.Добавить(ИнтервалСтруктура);
    КонецЦикла;
    
    // Добавление точек (сотрудников) и интервалов
    Для Каждого КлючЗначение Из ОтпускаПоСотрудникам Цикл
        Сотрудник = КлючЗначение.Ключ;
        МассивИнтервалов = КлючЗначение.Значение;
        
        // Точка – сотрудник
        Точка = ДиаграммаГанта.УстановитьТочку(Сотрудник.Наименование);
        Точка.Текст = Сотрудник.Наименование;
        
        // Значение для серии
        Значение = ДиаграммаГанта.ПолучитьЗначение(Точка, СерияОтпуск);
        
        // Добавляем все интервалы отпусков для этого сотрудника
        Для Каждого ИнтервалСтруктура Из МассивИнтервалов Цикл
            Интервал = Значение.Добавить();
            Интервал.Начало = ИнтервалСтруктура.Начало;
            Интервал.Конец = ИнтервалСтруктура.Конец;
            Интервал.Текст = Формат(Интервал.Начало, "ДЛФ=D") + " - " + Формат(Интервал.Конец, "ДЛФ=D");
		КонецЦикла; 
	КонецЦикла; 
	
	// НАСТРОЙКА ШКАЛЫ ВРЕМЕНИ 
    Шкалы = ДиаграммаГанта.ОбластьПостроения.ШкалаВремени.Элементы; 
	
    ШкалаМесяцев = Шкалы.Добавить();
    ШкалаМесяцев.Единица = ТипЕдиницыШкалыВремени.Месяц;
    ШкалаМесяцев.Кратность = 1;                     
    ШкалаМесяцев.Формат = "ДФ='MMMM yyyy'";  
    ШкалаМесяцев.Видимость = Истина;
    
	ШкалаДней = Шкалы.Добавить();
	ШкалаДней.Единица = ТипЕдиницыШкалыВремени.День;
	ШкалаДней.Кратность = 1;                     
	ШкалаДней.Формат = "ДФ=dd";      
	ШкалаДней.Видимость = Истина; 
	
	//   Явно задаём границы шкалы, чтобы охватить все интервалы
	//   Если этого не сделать, диаграмма подстроится автоматически, но иногда
	//   может обрезать края. Лучше вычислить минимум и максимум по всем отпускам.
	МинимальнаяДата = Неопределено;
	МаксимальнаяДата = Неопределено;
	
	Для Каждого КлючЗначение Из ОтпускаПоСотрудникам Цикл
	    МассивИнтервалов = КлючЗначение.Значение;
	    Для Каждого ИнтервалСтруктура Из МассивИнтервалов Цикл
	        Если МинимальнаяДата = Неопределено Или ИнтервалСтруктура.Начало < МинимальнаяДата Тогда
	            МинимальнаяДата = ИнтервалСтруктура.Начало;
	        КонецЕсли;
	        Если МаксимальнаяДата = Неопределено Или ИнтервалСтруктура.Конец > МаксимальнаяДата Тогда
	            МаксимальнаяДата = КонецГода(ИнтервалСтруктура.Конец);
	        КонецЕсли;
	    КонецЦикла;
	КонецЦикла; 
	
	ДиаграммаГанта.АвтоОпределениеПолногоИнтервала = Ложь;
	ДиаграммаГанта.УстановитьПолныйИнтервал(МинимальнаяДата, МаксимальнаяДата); 
	    
	//ДОБАВЛЕНИЕ МЕТКИ "СЕГОДНЯ" 
    Метка = ШкалаДней.Метки.Добавить(ТекущаяДатаСеанса());
    Метка.Текст = "Сегодня";
    Метка.ЦветТекста = WebЦвета.Красный;
    Метка.ЦветЛинии = WebЦвета.Красный;
    
    // Настройка внешнего вида диаграммы
    ДиаграммаГанта.ОтображениеИнтервала = ОтображениеИнтервалаДиаграммыГанта.Объемный;
    ДиаграммаГанта.ОтображениеТекстаЗначения = ОтображениеТекстаЗначенияДиаграммыГанта.Право;
    ДиаграммаГанта.ВертикальнаяПрокрутка = Истина;
	
	УдалитьИзВременногоХранилища(Параметры.Адрес);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
		
&НаКлиенте
Процедура СохранитьДиаграмму(Команда)
		
	Картинка = ДиаграммаГанта.ПолучитьКартинку(2000, 1000, ФорматКартинки.PNG);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Выберите имя файла для сохранения";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "Документ PNG (*.png)|*.png";
	Если Диалог.Выбрать() Тогда
		ИмяФайла = Диалог.ПолноеИмяФайла;
		Картинка.Записать(ИмяФайла);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

