
#Область ОбработчикиСобытийЭлементовТаблицыФормыОтпускаСотрудников

&НаКлиенте
Процедура ОтпускаСотрудниковДатаОкончанияПриИзменении(Элемент) 
	ТекущиеДанные = Элементы.ОтпускаСотрудников.ТекущиеДанные;
	РасчитатьКоличествоДней(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ОтпускаСотрудниковДатаНачалаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ОтпускаСотрудников.ТекущиеДанные;
	РасчитатьКоличествоДней(ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АнализГрафика(Команда) 
	
	Адрес = ПолучитьДанныеДляАнализаНаСервере();
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нет данных для анализа.");
		Возврат;
	КонецЕсли;
	
    ПараметрыФормы = Новый Структура("Адрес, Год", Адрес, Объект.Год);
    ОткрытьФорму("Документ.ВКМ_ГрафикОтпусков.Форма.АнализГрафика", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РасчитатьКоличествоДней(ТекущиеДанные);
	ТекущиеДанные.КоличествоДней = (ТекущиеДанные.ДатаОкончания - ТекущиеДанные.ДатаНачала) / 86400 + 1; 
КонецПроцедуры 
	
&НаСервере
Функция ПолучитьДанныеДляАнализаНаСервере() 
	
    Данные = Новый ТаблицаЗначений;
    Данные.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
    Данные.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
    Данные.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата"));
    
    Для Каждого Стр Из Объект.ОтпускаСотрудников Цикл
        Если Стр.Сотрудник = Неопределено ИЛИ Стр.ДатаНачала = '00010101' ИЛИ Стр.ДатаОкончания = '00010101' Тогда
            Продолжить;
        КонецЕсли;
        НоваяСтрока = Данные.Добавить();
        НоваяСтрока.Сотрудник = Стр.Сотрудник;
        НоваяСтрока.ДатаНачала = Стр.ДатаНачала;
        НоваяСтрока.ДатаОкончания = Стр.ДатаОкончания;
    КонецЦикла;
    
    Если Данные.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;
    
    Адрес = ПоместитьВоВременноеХранилище(Данные, Новый УникальныйИдентификатор);
    Возврат Адрес;	
КонецФункции 

#КонецОбласти