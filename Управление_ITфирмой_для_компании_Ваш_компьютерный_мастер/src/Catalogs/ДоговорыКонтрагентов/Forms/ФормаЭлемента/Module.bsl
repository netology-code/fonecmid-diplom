
// {{ Таркашова Н.Г. 09.05.2026 Добавление реквизитов для договора с типом: "Абонентское обсуживание"
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Группа = Элементы.Добавить("ВКМ_ГруппаАбонентскоеОбслуживание", Тип("ГруппаФормы"));
	Группа.Заголовок = "Абонентское обслуживание";
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = ЛОЖЬ; 
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ПодгруппаПраваяКолонка = Элементы.Добавить("ВКМ_ПраваяКолонка", Тип("ГруппаФормы"), Группа);
	ПодгруппаПраваяКолонка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПодгруппаПраваяКолонка.Отображение = ОтображениеОбычнойГруппы.Нет;
	ПодгруппаПраваяКолонка.ОтображатьЗаголовок = ЛОЖЬ; 
	ПодгруппаПраваяКолонка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;	

	ПодгруппаЛеваяКолонка = Элементы.Добавить("ВКМ_ЛеваяКолонка", Тип("ГруппаФормы"), Группа);
	ПодгруппаЛеваяКолонка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПодгруппаЛеваяКолонка.Отображение = ОтображениеОбычнойГруппы.Нет;
	ПодгруппаЛеваяКолонка.ОтображатьЗаголовок = ЛОЖЬ; 
	ПодгруппаЛеваяКолонка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	// Добавляем поля для новых реквизитов
    Элемент = Элементы.Добавить("ВКМ_ДатаНачала", Тип("ПолеФормы"), ПодгруппаПраваяКолонка);
    Элемент.Вид = ВидПоляФормы.ПолеВвода;
    Элемент.ПутьКДанным = "Объект.ВКМ_ДатаНачала";
    Элемент.Заголовок = "Дата начала действия";
    
    Элемент = Элементы.Добавить("ВКМ_ДатаОкончания", Тип("ПолеФормы"), ПодгруппаЛеваяКолонка);
    Элемент.Вид = ВидПоляФормы.ПолеВвода;
    Элемент.ПутьКДанным = "Объект.ВКМ_ДатаОкончания";
    Элемент.Заголовок = "Дата окончания действия";
    
    Элемент = Элементы.Добавить("ВКМ_СуммаАбонентскойПлаты", Тип("ПолеФормы"), ПодгруппаПраваяКолонка);
    Элемент.Вид = ВидПоляФормы.ПолеВвода;
    Элемент.ПутьКДанным = "Объект.ВКМ_СуммаАбонентскойПлаты";
    Элемент.Заголовок = "Сумма абонентской платы";
    
    Элемент = Элементы.Добавить("ВКМ_СтоимостьЧаса", Тип("ПолеФормы"), ПодгруппаЛеваяКолонка);
    Элемент.Вид = ВидПоляФормы.ПолеВвода;
    Элемент.ПутьКДанным = "Объект.ВКМ_СтоимостьЧаса";
    Элемент.Заголовок = "Стоимость часа работы специалиста";
    
    // Устанавливаем видимость группы в зависимости от вида договора
    ВКМ_ОбновитьВидимостьАбонентскихРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораПриИзменении(Элемент)
	ВКМ_ОбновитьВидимостьАбонентскихРеквизитов();
КонецПроцедуры 

&НаСервере
Процедура ВКМ_ОбновитьВидимостьАбонентскихРеквизитов()
	
	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда
		Элементы.ВКМ_ГруппаАбонентскоеОбслуживание.Видимость = Истина;
	Иначе
		Элементы.ВКМ_ГруппаАбонентскоеОбслуживание.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Таркашова Н.Г. 09.05.2026 }}