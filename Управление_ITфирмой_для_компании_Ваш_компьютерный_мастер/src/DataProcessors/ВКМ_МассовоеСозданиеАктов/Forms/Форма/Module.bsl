#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ЗаполнитьАкты(Команда)
    // Запуск длительной операции на сервере
    ДлительнаяОперация = НачатьВыполнениеНаСервере();
    ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультат", ЭтотОбъект);
    ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
    ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция НачатьВыполнениеНаСервере()
    // Генерируем уникальный идентификатор для связи с формой
    ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
    Возврат ДлительныеОперации.ВыполнитьФункцию(
        ПараметрыВыполнения,
        "Обработки.ВКМ_МассовоеСозданиеАктов.СоздатьАктыВФоне",
        Объект.Период);  // Структура с полями ДатаНачала и ДатаОкончания
    
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультат(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = Неопределено Тогда
       ОбщегоНазначенияКлиент.СообщитьПользователю("Длительная операция прервана или не дала результата.");
        Возврат;
    КонецЕсли;
    ПриЗавершенииСозданияАктов(Результат);
КонецПроцедуры

&НаСервере
Процедура ПриЗавершенииСозданияАктов(Результат)
    // Результат должен быть структурой с полем "АдресРезультата"
    Если ТипЗнч(Результат) <> Тип("Структура") Или НЕ Результат.Свойство("АдресРезультата") Тогда
        ОбщегоНазначения.СообщитьПользователю("Ошибка: неверный формат результата длительной операции.");
        Возврат;
    КонецЕсли;
    
    Попытка
        ОбновленнаяТаблица = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
        Если ОбновленнаяТаблица = Неопределено Тогда
            ОбщегоНазначения.СообщитьПользователю("Не удалось получить данные из временного хранилища.");
            Возврат;
        КонецЕсли;
        
        // Обновляем табличную часть формы
        Объект.СписокДоговоров.Очистить();
        Объект.СписокДоговоров.Загрузить(ОбновленнаяТаблица);
        
        // Принудительно обновляем отображение таблицы на форме
        Элементы.СписокДоговоров.Обновить();
        
		//// Подсчитываем успешные и ошибочные записи
		//Всего = ОбновленнаяТаблица.Количество();
		//Успешно = ОбновленнаяТаблица.КоличествоСтрок("НЕ ПустаяСсылка(АктРеализации) И НЕ ПустаяСтрока(Ошибка)");
		//СОшибками = ОбновленнаяТаблица.КоличествоСтрок("ПустаяСсылка(АктРеализации) И НЕ ПустаяСтрока(Ошибка)");
		//
		//Сообщить(СтрШаблон("Создание актов завершено. Обработано договоров: %1. Успешно создано: %2. Ошибок: %3",
		//    Всего, Успешно, СОшибками));
    Исключение
        ОбщегоНазначения.СообщитьПользователю("Ошибка при загрузке результата: " +  ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры

#КонецОбласти