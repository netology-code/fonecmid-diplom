
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс
// Создаёт акты реализации в фоновом режиме
// Функция выполняется в фоновом задании (длительная операция)
//
// Параметры:
//   Период - Дата - месяц (первое число месяца), за который создаются акты.
//
// Возвращаемое значение:
//   ТаблицаЗначений - результат обработки по каждому договору:
//     Договор: СправочникСсылка.ДоговорыКонтрагентов - договор
//     АктРеализации: ДокументСсылка.РеализацияТоваровУслуг - созданный или существующий акт
//     Ошибка: Строка - текст ошибки, если создание не удалось
//	
Функция СоздатьАктыВФоне(Период) Экспорт
    
    // 1. Получить список договоров за период (без учёта уже созданных)
    МассивДоговоров = ПолучитьДоговорыПоПериоду(Период);
    
    // 2. Найти уже существующие акты за этот месяц (чтобы не создавать повторно)
    СоответствиеАктов = ПолучитьСуществующиеАкты(МассивДоговоров, Период);
    
    // 3. Таблица для результата (будет отображаться в форме)
    ТаблицаДоговоров = Новый ТаблицаЗначений;
    ТаблицаДоговоров.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
    ТаблицаДоговоров.Колонки.Добавить("АктРеализации", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
    ТаблицаДоговоров.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Строка"));
    
    // 4. Предварительно загрузим суммы абонентской платы по всем договорам (оптимизация)
    СуммыАбонентскойПлаты = ПолучитьСуммыАбонентскойПлаты(МассивДоговоров);
    
    Всего = МассивДоговоров.Количество();
    ТекущийИндекс = 0;
    
    Для Каждого Договор Из МассивДоговоров Цикл
        ТекущийИндекс = ТекущийИндекс + 1;
        СтрокаТаблицы = ТаблицаДоговоров.Добавить();
        СтрокаТаблицы.Договор = Договор;
        
        // Если акт уже существует – просто сохраняем ссылку
        Если СоответствиеАктов.Получить(Договор) <> Неопределено Тогда
            СтрокаТаблицы.АктРеализации = СоответствиеАктов[Договор];
            ДлительныеОперации.СообщитьПрогресс(ТекущийИндекс * 100 / Всего,
                СтрШаблон("Договор %1: акт уже существует", Договор));
            Продолжить;
        КонецЕсли;
        
        // Пытаемся создать новый документ
		Попытка
			НачатьТранзакцию();
	        НовыйАкт = СоздатьИЗаполнитьАкт(Договор, Период, СуммыАбонентскойПлаты[Договор]);
            СтрокаТаблицы.АктРеализации = НовыйАкт.Ссылка;
            ДлительныеОперации.СообщитьПрогресс(ТекущийИндекс * 100 / Всего,
                СтрШаблон("Создан акт №%1 по договору %2", НовыйАкт.Номер, Договор));		// ... возможно, другие операции
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
            СтрокаТаблицы.Ошибка =  ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            ДлительныеОперации.СообщитьПрогресс(ТекущийИндекс * 100 / Всего,
                СтрШаблон("Ошибка по договору %1: %2", Договор, СтрокаТаблицы.Ошибка));
		КонецПопытки; 
        
    КонецЦикла;
	
	// Возврат новый таблицы 
    Возврат ТаблицаДоговоров;
    
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДоговорыПоПериоду(Период)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ДоговорыКонтрагентов.Ссылка КАК Договор
        |ИЗ
        |    Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
        |ГДЕ
        |    ДоговорыКонтрагентов.ВКМ_ДатаНачала <= &НачалоПериода
        |    И (ДоговорыКонтрагентов.ВКМ_ДатаОкончания >= &КонецПериода ИЛИ ДоговорыКонтрагентов.ВКМ_ДатаОкончания ЕСТЬ NULL)
        |    И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание)
        |    И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
    Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
    
    МассивДоговоров = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        МассивДоговоров.Добавить(Выборка.Договор);
    КонецЦикла;
    
    Возврат МассивДоговоров;
    
КонецФункции

Функция ПолучитьСуществующиеАкты(МассивДоговоров, Период)
	
    СоответствиеАктов = Новый Соответствие;
    Если МассивДоговоров.Количество() = 0 Тогда
        Возврат СоответствиеАктов;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ОбработкаЗаказов.Договор КАК Договор,
        |    ОбработкаЗаказов.Регистратор КАК АктРеализации
        |ИЗ
        |    РегистрНакопления.ОбработкаЗаказов КАК ОбработкаЗаказов
        |ГДЕ
        |    ОбработкаЗаказов.Период МЕЖДУ &НачалоПериода И &КонецПериода
        |    И ОбработкаЗаказов.Договор В(&МассивДоговоров)";
    
    Запрос.УстановитьПараметр("МассивДоговоров", МассивДоговоров);
    Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
    Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        СоответствиеАктов.Вставить(Выборка.Договор, Выборка.АктРеализации);
    КонецЦикла;
    Возврат СоответствиеАктов;
КонецФункции

Функция ПолучитьСуммыАбонентскойПлаты(МассивДоговоров)
    Суммы = Новый Соответствие;
    Если МассивДоговоров.Количество() = 0 Тогда
        Возврат Суммы;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ДоговорыКонтрагентов.Ссылка КАК Договор,
        |    ЕСТЬNULL(ДоговорыКонтрагентов.ВКМ_СуммаАбонентскойПлаты, 0) КАК Сумма
        |ИЗ
        |    Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
        |ГДЕ
        |    ДоговорыКонтрагентов.Ссылка В(&МассивДоговоров)";
    
    Запрос.УстановитьПараметр("МассивДоговоров", МассивДоговоров);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Суммы.Вставить(Выборка.Договор, Выборка.Сумма);
    КонецЦикла;
    Возврат Суммы;
КонецФункции

Функция СоздатьИЗаполнитьАкт(Договор, Период, СуммаАбонентскойПлаты)
    // Создаём документ
    НовыйАкт = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
    НовыйАкт.Дата = Период.ДатаОкончания;
    НовыйАкт.Организация = Договор.Организация;
    НовыйАкт.Контрагент = Договор.Владелец;
    НовыйАкт.Договор = Договор;
    
    // Вызываем автозаполнение (передаём сумму АП во избежание повторного запроса)
    НовыйАкт.ВыполнитьАвтозаполнение(СуммаАбонентскойПлаты, Период);
    
    // Проверка заполнения перед проведением
    Если НЕ НовыйАкт.ПроверитьЗаполнение() Тогда
        НовыйАкт.Записать(РежимЗаписиДокумента.Запись);
        ОбщегоНазначения.СообщитьПользователю("Не пройдена проверка заполнения документа");
    КонецЕсли;
    
    НовыйАкт.Записать(РежимЗаписиДокумента.Проведение);
    Возврат НовыйАкт;
КонецФункции
#КонецОбласти

#КонецЕсли