
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
	// 1. Собираем уникальных сотрудников и суммы выплат из табличной части
	ВыплатыПоСотрудникам = Новый Соответствие;
	Для каждого ТекСтрока Из Выплаты Цикл
		Сотрудник = ТекСтрока.Сотрудник;
		Сумма = ТекСтрока.Сумма;
		Если ВыплатыПоСотрудникам.Получить(Сотрудник) <> Неопределено Тогда
			ВыплатыПоСотрудникам[Сотрудник] = ВыплатыПоСотрудникам[Сотрудник] + Сумма;
		Иначе
			ВыплатыПоСотрудникам.Вставить(Сотрудник, Сумма);
		КонецЕсли;
	КонецЦикла;
	
	Если ВыплатыПоСотрудникам.Количество() = 0 Тогда
		Возврат; // нечего выплачивать
	КонецЕсли;
	
	// Формируем массив сотрудников из ключей соответствия
	МассивСотрудников = Новый Массив;
	Для каждого Элемент Из ВыплатыПоСотрудникам Цикл
	    МассивСотрудников.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	// 2. Запрашиваем остатки на дату документа (без учёта текущего документа)
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст = 
		"ВЫБРАТЬ
		|	ВКМ_ВзаиморасчетыССотрудникамиОстатки.Сотрудник КАК Сотрудник,
		|	ВКМ_ВзаиморасчетыССотрудникамиОстатки.СуммаОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.Остатки(&Дата, Сотрудник В (&МассивСотрудников)) КАК ВКМ_ВзаиморасчетыССотрудникамиОстатки";
	
	ЗапросОстатков.УстановитьПараметр("Дата", Дата);
	ЗапросОстатков.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	Результат = ЗапросОстатков.Выполнить();
	Выборка = Результат.Выбрать();
	
	// 3. Создаём соответствие остатков
	ОстаткиПоСотрудникам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ОстаткиПоСотрудникам.Вставить(Выборка.Сотрудник, Выборка.Остаток);
	КонецЦикла;
	
	// 4. Проверяем каждую выплату
	Для каждого КлючЗначение Из ВыплатыПоСотрудникам Цикл
		Сотрудник = КлючЗначение.Ключ;
		СуммаВыплаты = КлючЗначение.Значение;
		Остаток = ОстаткиПоСотрудникам.Получить(Сотрудник);
		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;
		
		Если СуммаВыплаты > Остаток Тогда
			ТекстОшибки = СтрШаблон(
				"Недостаточно средств для выплаты сотруднику %1. " +
				"Остаток долга: %2, запрошено к выплате: %3.",
				Сотрудник, Остаток, СуммаВыплаты);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
	КонецЦикла;

	// регистр ВКМ_ВзаиморасчетыССотрудниками Расход
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	Для Каждого ТекСтрокаВыплаты Из Выплаты Цикл
		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Сотрудник = ТекСтрокаВыплаты.Сотрудник;
		Движение.Сумма = ТекСтрокаВыплаты.Сумма;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли