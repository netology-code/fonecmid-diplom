#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)  
	
    // 1. Сформировать движения по регистрам расчёта (записи с базовыми данными)
    СформироватьДвижения();
    
    // 2. Выполнить расчёт 
	РасчитатьОсновныеНачисления();
    
    // 3. Дополнительные расчёты, не входящие в механизм регистра расчёта (Отпускные, НДФЛ)
	РассчитатьОтпускные();
	РассчитатьНДФЛ();
	
	// 4. Сформировать движения по взаиморасчётам
	СформироватьВзаиморасчеты();
	
	Ответственный = Пользователи.ТекущийПользователь(); 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьДвижения()  
	
    МассивСотрудников = Начисления.ВыгрузитьКолонку("Сотрудник");
    Если МассивСотрудников.Количество() = 0 Тогда
        Возврат;
	КонецЕсли;
	
	УникальныеСотрудники = Новый Массив;
    Для каждого Сотрудник Из МассивСотрудников Цикл
        Если УникальныеСотрудники.Найти(Сотрудник) = Неопределено Тогда
            УникальныеСотрудники.Добавить(Сотрудник);
        КонецЕсли;
    КонецЦикла;
    
    //1. Получаем оклады сотрудников на дату (процент не нужен, т.к. сумма работ уже содержит начисленный процент)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    УсловияОплаты.Сотрудник КАК Сотрудник,
        |    УсловияОплаты.Оклад КАК Оклад
        |ИЗ
        |    РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&НачалоМесяца, Сотрудник В (&МассивСотрудников)) КАК УсловияОплаты";
    
    Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Дата));
    Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    ОкладыПоСотрудникам = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        ОкладыПоСотрудникам.Вставить(Выборка.Сотрудник, Выборка.Оклад);
	КонецЦикла; 
	
	// ПРОВЕРКА: у каждого сотрудника должен быть задан оклад
    Для каждого Сотрудник Из УникальныеСотрудники Цикл
        Если ОкладыПоСотрудникам[Сотрудник] = Неопределено Тогда
            ТекстОшибки = СтрШаблон("Для сотрудника %1 не задан оклад в регистре ""Условия оплаты сотрудников"". Проведение документа невозможно.", Сотрудник);
            ОбщегоНазначения.СообщитьПользователю(ТекстОшибки); 
            ВызватьИсключение(ТекстОшибки);
        КонецЕсли;
    КонецЦикла;
    
    //2. Получаем сумму выполненных работ (уже содержащую сумму процента от работ) за месяц по каждому сотруднику
    ЗапросРабот = Новый Запрос;
    ЗапросРабот.Текст = 
        "ВЫБРАТЬ
        |	Выполненные.Сотрудник КАК Сотрудник,
        |	СУММА(Выполненные.СуммаКОплате) КАК СуммаРабот
        |ИЗ
        |	РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы КАК Выполненные
        |ГДЕ
        |	Выполненные.Период МЕЖДУ &НачалоМесяца И &КонецМесяца
        |	И Выполненные.Сотрудник В(&МассивСотрудников)
        |
        |СГРУППИРОВАТЬ ПО
        |	Выполненные.Сотрудник";
    
    ЗапросРабот.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Дата));
    ЗапросРабот.УстановитьПараметр("КонецМесяца", КонецМесяца(Дата));
    ЗапросРабот.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
    РезультатРабот = ЗапросРабот.Выполнить();
    ВыборкаРабот = РезультатРабот.Выбрать();
    
    СуммыРаботПоСотрудникам = Новый Соответствие;
    Пока ВыборкаРабот.Следующий() Цикл
        СуммыРаботПоСотрудникам.Вставить(ВыборкаРабот.Сотрудник, ВыборкаРабот.СуммаРабот);
	КонецЦикла;
	
    
    //3. Соединяем данные и вычисляем общую начисленную сумму = оклад + уже рассчитанный процент от работ
    ОбщаяНачисленнаяСумма = Новый Соответствие;
    Для Каждого Сотрудник Из МассивСотрудников Цикл
        Оклад = ?(ОкладыПоСотрудникам[Сотрудник] = Неопределено, 0, ОкладыПоСотрудникам[Сотрудник]);
        СуммаРабот = ?(СуммыРаботПоСотрудникам[Сотрудник] = Неопределено, 0, СуммыРаботПоСотрудникам[Сотрудник]);
        // СуммаРабот уже содержит процент от выполненных работ, поэтому просто прибавляем
        ОбщаяНачисленнаяСумма.Вставить(Сотрудник, Оклад + СуммаРабот);
    КонецЦикла; 
    
    // Очищаем движения
    Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
    Движения.ВКМ_ОсновныеНачисления.Очистить();
    
    // Формируем движения, заполняя Результат из рассчитанной суммы
    Для Каждого Строка Из Начисления Цикл 
        Если ТипЗнч(Строка.ВидРасчета) = Тип("ПланВидовРасчетаСсылка.ВКМ_ОсновныеНачисления") Тогда
            Движение = Движения.ВКМ_ОсновныеНачисления.Добавить();
            Движение.ПериодДействияНачало = Строка.ДатаНачала;
            Движение.ПериодДействияКонец = Строка.ДатаОкончания;
            Движение.ГрафикРаботы = Строка.ГрафикРаботы; 
            Движение.ПериодРегистрации = Дата;        
            Движение.ВидРасчета = Строка.ВидРасчета;
            Движение.Сотрудник = Строка.Сотрудник;
			Движение.Размер = ОбщаяНачисленнаяСумма[Строка.Сотрудник];
        Иначе 
            ОбщегоНазначения.СообщитьПользователю("Документ предназначен только для основных начислений!");
        КонецЕсли;     
    КонецЦикла;
    
    Движения.ВКМ_ОсновныеНачисления.Записать();
КонецПроцедуры

Процедура РасчитатьОсновныеНачисления()
    // Запрос к виртуальной таблице "ДанныеГрафика" регистра расчёта
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |	ВКМ_ОсновныеНачисленияДанныеГрафика.НомерСтроки КАК НомерСтроки,
                   |	ВКМ_ОсновныеНачисленияДанныеГрафика.ЗначениеПериодДействия КАК План,
                   |	ВКМ_ОсновныеНачисленияДанныеГрафика.ЗначениеФактическийПериодДействия КАК Факт
                   |ИЗ
                   |	РегистрРасчета.ВКМ_ОсновныеНачисления.ДанныеГрафика(
                   |			ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ВКМ_ОсновныеНачисления.Оклад)
                   |				И Регистратор = &Ссылка) КАК ВКМ_ОсновныеНачисленияДанныеГрафика";
    
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Пока Выборка.Следующий() Цикл
        Движение = Движения.ВКМ_ОсновныеНачисления[Выборка.НомерСтроки - 1];
       	Движение.Результат = (Движение.Размер / Выборка.План) * Выборка.Факт;       
	КонецЦикла; 
    
    // Записываем рассчитанные результаты
    Движения.ВКМ_ОсновныеНачисления.Записать(, Истина); 
	
КонецПроцедуры

Процедура РассчитатьОтпускные()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Отпуск.Сотрудник КАК Сотрудник,
		|	СУММА(Отпуск.КоличествоКалендарныхДней) КАК КоличествоКалендарныхДней,
		|	СУММА(Год.Результат) КАК Результат,
		|	СУММА(Год.Факт) КАК Факт,
		|	СУММА(Год.План) КАК План
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВКМ_ОсновныеНачисленияДанныеГрафика.Сотрудник КАК Сотрудник,
		|		1 + РАЗНОСТЬДАТ(ВКМ_ОсновныеНачисленияДанныеГрафика.ПериодДействияНачало, ВКМ_ОсновныеНачисленияДанныеГрафика.ПериодДействияКонец, ДЕНЬ) КАК КоличествоКалендарныхДней
		|	ИЗ
		|		РегистрРасчета.ВКМ_ОсновныеНачисления.ДанныеГрафика(
		|				ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ВКМ_ОсновныеНачисления.Отпускные)
		|					И Регистратор = &Ссылка) КАК ВКМ_ОсновныеНачисленияДанныеГрафика) КАК Отпуск
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВКМ_ОсновныеНачисленияДанныеГрафика.Сотрудник КАК Сотрудник,
		|			СУММА(ВКМ_ОсновныеНачисленияДанныеГрафика.Результат) КАК Результат,
		|			СУММА(ВКМ_ОсновныеНачисленияДанныеГрафика.ЗначениеФактическийПериодДействия) КАК Факт,
		|			СУММА(ВКМ_ОсновныеНачисленияДанныеГрафика.ЗначениеПериодДействия) КАК План
		|		ИЗ
		|			РегистрРасчета.ВКМ_ОсновныеНачисления.ДанныеГрафика(ПериодДействия МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаДокумента, ГОД, -1) И &ДатаДокумента) КАК ВКМ_ОсновныеНачисленияДанныеГрафика
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ВКМ_ОсновныеНачисленияДанныеГрафика.Сотрудник) КАК Год
		|		ПО (Отпуск.Сотрудник = Год.Сотрудник)
		|
		|СГРУППИРОВАТЬ ПО
		|	Отпуск.Сотрудник";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДатаДокумента", Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Создадим соответствие для быстрого поиска расчётных данных по сотруднику
	ДанныеПоСотрудникам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Структура = Новый Структура("КоличествоКалендарныхДней, Результат, Факт, План",
			Выборка.КоличествоКалендарныхДней,
			Выборка.Результат,
			Выборка.Факт,
			Выборка.План);
		ДанныеПоСотрудникам.Вставить(Выборка.Сотрудник, Структура);
	КонецЦикла;
	
	// Обновляем движения для отпускных
	Для Каждого Движение Из Движения.ВКМ_ОсновныеНачисления Цикл
		Если Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпускные Тогда
			Сотрудник = Движение.Сотрудник;
			Данные = ДанныеПоСотрудникам[Сотрудник];
			Если Данные <> Неопределено И ЗначениеЗаполнено(Данные.Факт) Тогда
				СДЗ = Данные.Результат / Данные.Факт;
				Движение.Результат = СДЗ * Данные.КоличествоКалендарныхДней;
			Иначе
				Движение.Результат = 0; // если нет данных за год
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Движения.ВКМ_ОсновныеНачисления.Записать(, Истина);	
КонецПроцедуры

Процедура РассчитатьНДФЛ()
    // Получаем сумму всех начислений
	Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ОсновныеНачисления.Сотрудник КАК Сотрудник,
        |	СУММА(ОсновныеНачисления.Результат) КАК СуммаНачислено
        |ИЗ
        |	РегистрРасчета.ВКМ_ОсновныеНачисления КАК ОсновныеНачисления
        |ГДЕ
        |	ОсновныеНачисления.Регистратор = &Ссылка
        |
        |СГРУППИРОВАТЬ ПО
        |	ОсновныеНачисления.Сотрудник";
    
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    // Создаём движения по удержаниям
    Движения.ВКМ_Удержания.Записывать = Истина;
    Движения.ВКМ_Удержания.Очистить();
    
    Пока Выборка.Следующий() Цикл
        НДФЛ = Выборка.СуммаНачислено * 13 / 100;
        Если НДФЛ = 0 Тогда
            Продолжить;
        КонецЕсли;
        Движение = Движения.ВКМ_Удержания.Добавить();
        Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
        Движение.ПериодДействияНачало = НачалоМесяца(Дата);
        Движение.ПериодДействияКонец = КонецМесяца(Дата);
        Движение.ПериодРегистрации = Дата;
        Движение.Сотрудник = Выборка.Сотрудник;
        Движение.Результат = НДФЛ;
    КонецЦикла;
    
    Движения.ВКМ_Удержания.Записать();
КонецПроцедуры

Процедура СформироватьВзаиморасчеты()
    // 1. Очистка движений регистра взаиморасчётов
    Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
    Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
    
    // 2. Запрос сумм начислений по сотрудникам из текущего документа
    ЗапросНачисления = Новый Запрос;
    ЗапросНачисления.Текст = 
        "ВЫБРАТЬ
        |	ОсновныеНачисления.Сотрудник КАК Сотрудник,
        |	СУММА(ОсновныеНачисления.Результат) КАК СуммаНачислено
        |ИЗ
        |	РегистрРасчета.ВКМ_ОсновныеНачисления КАК ОсновныеНачисления
        |ГДЕ
        |	ОсновныеНачисления.Регистратор = &Ссылка
        |
        |СГРУППИРОВАТЬ ПО
        |	ОсновныеНачисления.Сотрудник";
    
    ЗапросНачисления.УстановитьПараметр("Ссылка", Ссылка);
    РезультатНачисления = ЗапросНачисления.Выполнить();
    
    // 3. Запрос сумм удержаний по сотрудникам из текущего документа
    ЗапросУдержания = Новый Запрос;
    ЗапросУдержания.Текст = 
        "ВЫБРАТЬ
        |	Удержания.Сотрудник КАК Сотрудник,
        |	СУММА(Удержания.Результат) КАК СуммаУдержано
        |ИЗ
        |	РегистрРасчета.ВКМ_Удержания КАК Удержания
        |ГДЕ
        |	Удержания.Регистратор = &Ссылка
        |
        |СГРУППИРОВАТЬ ПО
        |	Удержания.Сотрудник";
    
    ЗапросУдержания.УстановитьПараметр("Ссылка", Ссылка);
    РезультатУдержания = ЗапросУдержания.Выполнить();
    
    // 4. Помещаем результаты в соответствия для быстрого доступа
    НачисленияПоСотрудникам = Новый Соответствие;
    ВыборкаНач = РезультатНачисления.Выбрать();
    Пока ВыборкаНач.Следующий() Цикл
        НачисленияПоСотрудникам.Вставить(ВыборкаНач.Сотрудник, ВыборкаНач.СуммаНачислено);
    КонецЦикла;
    
    УдержанияПоСотрудникам = Новый Соответствие;
    ВыборкаУд = РезультатУдержания.Выбрать();
    Пока ВыборкаУд.Следующий() Цикл
        УдержанияПоСотрудникам.Вставить(ВыборкаУд.Сотрудник, ВыборкаУд.СуммаУдержано);
    КонецЦикла;
    
    // 5. Формируем движения взаиморасчётов
    Для каждого КлючЗначение Из НачисленияПоСотрудникам Цикл
        Сотрудник = КлючЗначение.Ключ;
        СуммаНачислено = КлючЗначение.Значение;
        СуммаУдержано = УдержанияПоСотрудникам.Получить(Сотрудник);
        Если СуммаУдержано = Неопределено Тогда
            СуммаУдержано = 0;
        КонецЕсли;
        
        СуммаКВыплате = СуммаНачислено - СуммаУдержано;
        Если СуммаКВыплате = 0 Тогда
            Продолжить;
        КонецЕсли;
        
        // Добавляем движение в регистр взаиморасчётов
        Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;   // увеличиваем долг предприятия
        Движение.Период = Дата;                                 // дата документа
        Движение.Сотрудник = Сотрудник;
        Движение.Сумма = СуммаКВыплате;
    КонецЦикла;
    
    // 6. Записываем движения
    Движения.ВКМ_ВзаиморасчетыССотрудниками.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли