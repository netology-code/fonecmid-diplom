#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	СформироватьДвижения(); 
	РассчитатьНДФЛ();
	СформироватьВзаиморасчеты();
	Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьДвижения()
    Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
    Движения.ВКМ_ДополнительныеНачисления.Очистить();
    Для Каждого СтрокаТЧ из Премии Цикл
	    Движение = Движения.ВКМ_ДополнительныеНачисления.Добавить();
		Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ФиксированнаяПремия; 
	    Движение.ПериодРегистрации = Дата;
	    Движение.Сотрудник = СтрокаТЧ.Сотрудник;
		Движение.Результат = СтрокаТЧ.Сумма;
	КонецЦикла;
            
    Движения.ВКМ_ДополнительныеНачисления.Записать();
КонецПроцедуры 

Процедура РассчитатьНДФЛ()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |	ВКМ_ДополнительныеНачисления.Сотрудник КАК Сотрудник,
                   |	СУММА(ВКМ_ДополнительныеНачисления.Результат) КАК СуммаНачислено
                   |ИЗ
                   |	РегистрРасчета.ВКМ_ДополнительныеНачисления КАК ВКМ_ДополнительныеНачисления
                   |ГДЕ
                   |	ВКМ_ДополнительныеНачисления.Регистратор = &Ссылка
                   |
                   |СГРУППИРОВАТЬ ПО
                   |	ВКМ_ДополнительныеНачисления.Сотрудник";
    
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    // Создаём движения по удержаниям
    Движения.ВКМ_Удержания.Записывать = Истина;
    Движения.ВКМ_Удержания.Очистить();
    
    Пока Выборка.Следующий() Цикл
        НДФЛ = Выборка.СуммаНачислено * 13 / 100;
        Если НДФЛ = 0 Тогда
            Продолжить;
        КонецЕсли;
        Движение = Движения.ВКМ_Удержания.Добавить();
        Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
        Движение.ПериодРегистрации = Дата;
        Движение.Сотрудник = Выборка.Сотрудник;
        Движение.Результат = НДФЛ;
    КонецЦикла;
    
    Движения.ВКМ_Удержания.Записать();
КонецПроцедуры

Процедура СформироватьВзаиморасчеты()
    // 1. Очистка движений регистра взаиморасчётов
    Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
    Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
    
    // 2. Запрос сумм начислений по сотрудникам из текущего документа
    ЗапросНачисления = Новый Запрос;
    ЗапросНачисления.Текст =  "ВЫБРАТЬ
                              |	ВКМ_ДополнительныеНачисления.Сотрудник КАК Сотрудник,
                              |	СУММА(ВКМ_ДополнительныеНачисления.Результат) КАК СуммаНачислено
                              |ИЗ
                              |	РегистрРасчета.ВКМ_ДополнительныеНачисления КАК ВКМ_ДополнительныеНачисления
                              |ГДЕ
                              |	ВКМ_ДополнительныеНачисления.Регистратор = &Ссылка
                              |
                              |СГРУППИРОВАТЬ ПО
                              |	ВКМ_ДополнительныеНачисления.Сотрудник";
    
    ЗапросНачисления.УстановитьПараметр("Ссылка", Ссылка);
    РезультатНачисления = ЗапросНачисления.Выполнить();
    
    // 3. Запрос сумм удержаний по сотрудникам из текущего документа
    ЗапросУдержания = Новый Запрос;
    ЗапросУдержания.Текст = "ВЫБРАТЬ
                            |	ВКМ_Удержания.Сотрудник КАК Сотрудник,
                            |	СУММА(ВКМ_Удержания.Результат) КАК СуммаУдержано
                            |ИЗ
                            |	РегистрРасчета.ВКМ_Удержания КАК ВКМ_Удержания
                            |ГДЕ
                            |	ВКМ_Удержания.Регистратор = &Ссылка
                            |
                            |СГРУППИРОВАТЬ ПО
                            |	ВКМ_Удержания.Сотрудник" ;
    
    ЗапросУдержания.УстановитьПараметр("Ссылка", Ссылка);
    РезультатУдержания = ЗапросУдержания.Выполнить();
    
    // 4. Помещаем результаты в соответствия для быстрого доступа
    НачисленияПоСотрудникам = Новый Соответствие;
    ВыборкаНач = РезультатНачисления.Выбрать();
    Пока ВыборкаНач.Следующий() Цикл
        НачисленияПоСотрудникам.Вставить(ВыборкаНач.Сотрудник, ВыборкаНач.СуммаНачислено);
    КонецЦикла;
    
    УдержанияПоСотрудникам = Новый Соответствие;
    ВыборкаУд = РезультатУдержания.Выбрать();
    Пока ВыборкаУд.Следующий() Цикл
        УдержанияПоСотрудникам.Вставить(ВыборкаУд.Сотрудник, ВыборкаУд.СуммаУдержано);
    КонецЦикла;
    
    // 5. Формируем движения взаиморасчётов
    Для каждого КлючЗначение Из НачисленияПоСотрудникам Цикл
        Сотрудник = КлючЗначение.Ключ;
        СуммаНачислено = КлючЗначение.Значение;
        СуммаУдержано = УдержанияПоСотрудникам.Получить(Сотрудник);
        Если СуммаУдержано = Неопределено Тогда
            СуммаУдержано = 0;
        КонецЕсли;
        
        СуммаКВыплате = СуммаНачислено - СуммаУдержано;
        Если СуммаКВыплате = 0 Тогда
            Продолжить;
        КонецЕсли;
        
        // Добавляем движение в регистр взаиморасчётов
        Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;   // увеличиваем долг предприятия
        Движение.Период = Дата;                                 // дата документа
        Движение.Сотрудник = Сотрудник;
        Движение.Сумма = СуммаКВыплате;
    КонецЦикла;
    
    // 6. Записываем движения
    Движения.ВКМ_ВзаиморасчетыССотрудниками.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

