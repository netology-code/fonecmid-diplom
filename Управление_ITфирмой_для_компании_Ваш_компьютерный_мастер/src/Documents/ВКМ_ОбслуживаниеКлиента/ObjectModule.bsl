#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим) 

    // 1. Получить данные договора (с проверкой вида)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Договор.ВКМ_СтоимостьЧаса КАК СтоимостьЧаса,
        |    Договор.ВКМ_ДатаНачала КАК ДатаНачала,
        |    Договор.ВКМ_ДатаОкончания КАК ДатаОкончания
        |ИЗ
        |    Справочник.ДоговорыКонтрагентов КАК Договор
        |ГДЕ
        |    Договор.Ссылка = &Договор
        |    И Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание)";
    
    Запрос.УстановитьПараметр("Договор", Договор);
    Результат = Запрос.Выполнить();
    
    Если Результат.Пустой() Тогда
        ОбщегоНазначения.СообщитьПользователю("Договор должен быть с видом ""Абонентское обслуживание""",, "Договор", "Договор"); 
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    ВыборкаДоговора = Результат.Выбрать();
    ВыборкаДоговора.Следующий();
    
    // 2. Проверка периода действия договора
    Если Дата < НачалоДня(ВыборкаДоговора.ДатаНачала) ИЛИ Дата > КонецДня(ВыборкаДоговора.ДатаОкончания) Тогда
        ОбщегоНазначения.СообщитьПользователю(
            СтрШаблон("Дата документа (%1) не входит в период действия договора с %2 по %3",
                Формат(Дата, "ДФ=dd.MM.yyyy"),
                Формат(ВыборкаДоговора.ДатаНачала, "ДФ=dd.MM.yyyy"),
                Формат(ВыборкаДоговора.ДатаОкончания, "ДФ=dd.MM.yyyy")),,
            "Дата",, Истина);
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    // 3. Проверка наличия процента у специалиста на дату документа
    ЗапросПроцент = Новый Запрос;
    ЗапросПроцент.Текст = "ВЫБРАТЬ
                          |	ВКМ_УсловияОплатыСотрудниковСрезПоследних.ПроцентОтРабот КАК ПроцентОтРабот
                          |ИЗ
                          |	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&Дата, ) КАК ВКМ_УсловияОплатыСотрудниковСрезПоследних
                          |ГДЕ
                          |	ВКМ_УсловияОплатыСотрудниковСрезПоследних.Сотрудник = &Сотрудник";
    
    ЗапросПроцент.УстановитьПараметр("Сотрудник", Специалист);
    ЗапросПроцент.УстановитьПараметр("Дата", Дата);
    РезультатПроцент = ЗапросПроцент.Выполнить();
    
    Если РезультатПроцент.Пустой() Тогда
        ОбщегоНазначения.СообщитьПользователю(
            СтрШаблон("Для сотрудника %1 не установлен процент оплаты от работ на дату %2",
                Специалист, Формат(Дата, "ДФ=dd.MM.yyyy")),,
            "Специалист", "Специалист", Истина);
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    ВыборкаПроцент = РезультатПроцент.Выбрать();
    ВыборкаПроцент.Следующий();
    Процент = ВыборкаПроцент.ПроцентОтРабот;  // может быть 0
    
    // 4. Формирование движений по регистрам
    Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
    Движения.ВКМ_ВыполненныеКлиентуРаботы.Очистить(); 
    
    Движения.ВКМ_ВыполненныеСотрудникомРаботы.Записывать = Истина;
    Движения.ВКМ_ВыполненныеСотрудникомРаботы.Очистить();
    
    Для каждого ТекСтрока из ВыполненныеРаботы Цикл
        Если ТекСтрока.ЧасыКОплатеКлиенту <= 0 Тогда
            Продолжить;
        КонецЕсли;
        
        // Движение в регистр "Выполненные клиенту работы" (полная стоимость для клиента)
        Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
        Движение.Период = Дата;
        Движение.Клиент = Клиент;
        Движение.Договор = Договор;
        Движение.КоличествоЧасов = ТекСтрока.ЧасыКОплатеКлиенту;
        Движение.СуммаКОплате = ТекСтрока.ЧасыКОплатеКлиенту * ВыборкаДоговора.СтоимостьЧаса;
        
        // Движение в регистр "Выполненные сотрудником работы" (сумма для зарплаты с учётом процента)
        СуммаКОплатеСотруднику = (ТекСтрока.ЧасыКОплатеКлиенту * ВыборкаДоговора.СтоимостьЧаса) * (Процент / 100);
        
        ДвижениеСР = Движения.ВКМ_ВыполненныеСотрудникомРаботы.Добавить();
        ДвижениеСР.Период = Дата;
        ДвижениеСР.Сотрудник = Специалист;
        ДвижениеСР.ЧасыКОплате = ТекСтрока.ЧасыКОплатеКлиенту; 
        ДвижениеСР.СуммаКОплате = СуммаКОплатеСотруднику;
    КонецЦикла;
    
    Движения.ВКМ_ВыполненныеКлиентуРаботы.Записать();
    Движения.ВКМ_ВыполненныеСотрудникомРаботы.Записать();    
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
    
    Если РежимЗаписи = РежимЗаписиДокумента.Запись ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
        Если Ссылка.Пустая() Тогда
            // Новый документ
            СоздатьУведомление(СтрШаблон("Создана новая заявка от %1, специалист: %2",
                Формат(Дата, "ДФ=dd.MM.yyyy ЧЧ:мм:сс"),
                Специалист));
        Иначе
            // Существующий документ — получаем старые значения через запрос
            Запрос = Новый Запрос;
            Запрос.Текст = 
            "ВЫБРАТЬ
            |	Документ.Дата КАК Дата,
            |	Документ.Специалист КАК Специалист
            |ИЗ
            |	Документ.ВКМ_ОбслуживаниеКлиента КАК Документ
            |ГДЕ
            |	Документ.Ссылка = &Ссылка";
            
            Запрос.УстановитьПараметр("Ссылка", Ссылка);
            Результат = Запрос.Выполнить();
            Выборка = Результат.Выбрать();
            
            Если Выборка.Следующий() Тогда
                СтараяДата = Выборка.Дата;
                СтарыйСпециалист = Выборка.Специалист;
                
                СписокИзменений = Новый Массив;
                
                // Сравнение даты+времени
                Если СтараяДата <> Дата Тогда
                    СтараяДатаСтр = Формат(СтараяДата, "ДФ=dd.MM.yyyy ЧЧ:мм:сс");
                    НоваяДатаСтр = Формат(Дата, "ДФ=dd.MM.yyyy ЧЧ:мм:сс");
                    СписокИзменений.Добавить("дата/время с " + СтараяДатаСтр + " на " + НоваяДатаСтр);
                КонецЕсли;
                
                // Сравнение специалиста
                Если СтарыйСпециалист <> Специалист Тогда
                    СтарыйСпец = ?(СтарыйСпециалист = Неопределено, "не указан", СтарыйСпециалист);
                    НовыйСпец = ?(Специалист = Неопределено, "не указан", Специалист);
                    СписокИзменений.Добавить("специалист с " + СтарыйСпец + " на " + НовыйСпец);
                КонецЕсли;
                
                Если СписокИзменений.Количество() > 0 Тогда
                    Текст = СтрШаблон("В заявке № %1 изменено: %2",
                                      Номер,
                                      СтрСоединить(СписокИзменений, "," + Символы.ПС));
                    СоздатьУведомление(Текст);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура СоздатьУведомление(ТекстСообщения)
    Уведомление = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
    Уведомление.Текст = ТекстСообщения;
    Уведомление.Записать();
КонецПроцедуры
#КонецОбласти

#КонецЕсли
